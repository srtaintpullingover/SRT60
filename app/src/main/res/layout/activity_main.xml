<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#00D632">

    <!-- Top Header (QR, Search, Profile) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <!-- Smiley on Left -->
        <TextView
            android:id="@+id/btnSmiley"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="☺"
            android:textSize="24sp"
            android:textColor="#000000" />

        <!-- QR Code (Right side of group) -->
        <TextView
            android:id="@+id/btnQR"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="52dp"
            android:gravity="center"
            android:text="▣"
            android:textSize="22sp"
            android:textColor="#000000" />

        <!-- Search Icon -->
        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="⌕"
            android:textSize="24sp"
            android:textColor="#000000" />

        <!-- Profile Picture -->
        <TextView
            android:id="@+id/btnProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="52dp"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="●"
            android:textSize="18sp"
            android:textColor="#000000" />

    </RelativeLayout>

    <!-- Big Amount -->
    <TextView
        android:id="@+id/txtAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="$0"
        android:textColor="#000000"
        android:textSize="80sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <!-- KEYPAD: Transparent buttons, Black Text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Row 4 (Dot, Zero, Backspace) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="." android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="0" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
            <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="&lt;" android:backgroundTint="#00D632" android:textColor="#000000" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Pill Buttons (Flat Green) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnPool"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Pool"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00B02A"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnRequest"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Request"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00B02A"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Black Pay Button (Rounded Rectangle) -->
    <Button
        android:id="@+id/btnPay"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="Pay"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#000000"
        android:stateListAnimator="@null" />

    <include
        layout="@layout/bottom_nav" />

</LinearLayout>