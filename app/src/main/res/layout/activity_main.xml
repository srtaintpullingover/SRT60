<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#00D632"
    android:padding="20dp">

    <!-- Top spacing -->
    <View
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <!-- Amount -->
    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="$0"
        android:textColor="#000000"
        android:textSize="64sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Number pad -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/btn1" android:text="1" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn2" android:text="2" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn3" android:text="3" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />

        <Button android:id="@+id/btn4" android:text="4" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn5" android:text="5" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn6" android:text="6" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />

        <Button android:id="@+id/btn7" android:text="7" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn8" android:text="8" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn9" android:text="9" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />

        <Button android:id="@+id/btnDot" android:text="." android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn0" android:text="0" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btnBack" android:text="&lt;" android:textSize="32sp" android:textColor="#000000" android:background="@android:color/transparent" android:layout_columnWeight="1" android:layout_rowWeight="1" />
    </GridLayout>

    <!-- Pool + Request -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnPool"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Pool"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#00B02A"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnRequest"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Request"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#00B02A"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Pay button -->
    <Button
        android:id="@+id/btnPay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Pay"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#000000" />

</LinearLayout>
