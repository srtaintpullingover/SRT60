<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/savings_bg"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/poolName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pool Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/poolDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#8888b8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/poolMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 members"
            android:textColor="#818cf8"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/poolAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0"
        android:textColor="#00D632"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
