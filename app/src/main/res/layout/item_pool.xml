<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card_dark"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/txtPoolName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trip Fund"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPoolDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vacation"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtPoolBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00 / $500.00"
        android:textColor="#00D632"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="15dp" />

    <TextView
        android:id="@+id/txtPoolMembers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 member"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
